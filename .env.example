# Copy to .env and adjust. Every value has a default in docker-compose.yml,
# so `docker compose up` also works without a .env file.

POSTGRES_DB=platescan
POSTGRES_PORT=5432

# Bootstrap superuser (init scripts only)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

# Owns the schema, runs migrations
DB_OWNER_USER=app_owner
DB_OWNER_PASSWORD=app_owner_pw

# Runtime app role: DML only, subject to row-level security
DB_APP_USER=app_rw
DB_APP_PASSWORD=app_rw_pw
